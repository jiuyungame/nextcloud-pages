[Unit]
Description=pages-bridge — host-side executor for the Nextcloud Pages app (mirror + build + git)
Documentation=https://github.com/jiuyungame/nextcloud-pages
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m pages_bridge -c /etc/pages-bridge/pages-bridge.toml serve
WorkingDirectory=/opt/pages-bridge
Restart=always
RestartSec=3
# No RestartPreventExitStatus any more: the old exit 78 guarded a bridge-written target set that no
# longer exists. The three trees are derived, so a stale or missing tree is rebuilt from the
# Nextcloud folders at startup instead of refusing to start.

# the service needs read access to the Nextcloud data dir and write access to the work root
User=root
Group=root

Environment=HOME=/root
Environment=PAGES_BRIDGE_LOG=info
Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=true

# PrivateTmp stays off: the work root holds data (the commit and review trees live under
# /var/lib/pages/work by default) and must be reachable at its real path for backups and tools.
PrivateTmp=false

ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# ProtectHome stays off on purpose: work_root may sit under /root
# ProtectSystem=strict stays off on purpose: the reverse flow writes into the Nextcloud data dir

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pages-bridge

[Install]
WantedBy=multi-user.target
